<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ficha del Producto en la Tienda Online: Mostrar Logo / Badge de Marca Estilizado -->
    <template id="product_brand_website_sale_product_title" inherit_id="website_sale.product_title" name="Product Brand on Product Page">
        <xpath expr="//h1" position="before">
            <t t-if="product.brand_id">
                <div class="product-brand-header mb-3">
                    <div class="d-inline-flex align-items-center flex-wrap gap-2">
                        <a t-attf-href="/shop?brand=#{product.brand_id.id}" 
                           t-attf-title="Ver catálogo de #{product.brand_id.name}" 
                           class="d-inline-flex align-items-center text-decoration-none">
                            <t t-if="product.brand_id.logo">
                                <div class="brand-logo-badge bg-white border rounded-3 p-2 shadow-sm d-inline-flex align-items-center justify-content-center"
                                     style="min-height: 48px; max-height: 58px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                    <img t-attf-src="/web/image/product.brand/#{product.brand_id.id}/logo" 
                                         t-att-alt="product.brand_id.name" 
                                         class="img img-fluid" 
                                         style="max-height: 46px; max-width: 155px; width: auto; height: auto; object-fit: contain;"/>
                                </div>
                            </t>
                            <t t-else="">
                                <span class="badge text-bg-light border px-3 py-2 text-dark fs-6 fw-semibold rounded-pill shadow-sm">
                                    <i class="fa fa-tag me-2 text-primary"/>
                                    <span t-out="product.brand_id.name"/>
                                </span>
                            </t>
                        </a>
                        <a t-attf-href="/shop?brand=#{product.brand_id.id}" 
                           class="btn btn-link btn-sm text-decoration-none text-muted p-0 ms-1 d-inline-flex align-items-center"
                           style="font-size: 0.85rem;"
                           t-attf-title="Explorar todos los productos de #{product.brand_id.name}">
                            <span>Ver todos los productos de esta marca</span>
                            <i class="fa fa-chevron-right ms-1 small" style="font-size: 0.7rem;"/>
                        </a>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Catálogo de la Tienda: Indicador de Filtro de Marca Activo -->
    <template id="product_brand_website_sale_products" inherit_id="website_sale.products" name="Active Brand Filter in Shop">
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <t t-if="active_brand">
                <div class="col-12 mb-3">
                    <div class="alert alert-light border d-flex justify-content-between align-items-center py-2 px-3 m-0 shadow-sm rounded">
                        <div class="d-flex align-items-center">
                            <t t-if="active_brand.logo">
                                <img t-attf-src="/web/image/product.brand/#{active_brand.id}/logo" 
                                     t-att-alt="active_brand.name" 
                                     class="img img-fluid me-2" 
                                     style="max-height: 32px; max-width: 100px; object-fit: contain;"/>
                            </t>
                            <span>
                                Productos de la marca: <strong><t t-out="active_brand.name"/></strong>
                            </span>
                        </div>
                        <a href="/shop" class="btn btn-sm btn-outline-secondary" title="Quitar filtro de marca">
                            <i class="fa fa-times me-1"/> Limpiar filtro
                        </a>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
