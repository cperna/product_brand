<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extensión de Vista Formulario de Product Template -->
    <record id="product_template_form_brand_view" model="ir.ui.view">
        <field name="name">product.template.form.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id" options="{'no_create_edit': False}"/>
            </xpath>
        </field>
    </record>

    <!-- Extensión de Vista de Búsqueda de Product Template -->
    <record id="product_template_search_brand_view" model="ir.ui.view">
        <field name="name">product.template.search.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="brand_id" string="Brand"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="With Brand" name="with_brand" domain="[('brand_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Brand" name="group_by_brand" context="{'group_by': 'brand_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
